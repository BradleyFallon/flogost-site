---
import { Image } from "astro:assets";
import eventFlyer from "../../assets/root-and-resonance-flyer.png";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { event } from "../../data/site";

const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title={`${event.title} — FLOGOST`} description={`FLOGOST at ${event.title}, ${event.displayDate} in Portland, Oregon.`}>
  <article class="event-page shell">
    <a class="back-link" href={homeUrl}>← FLOGOST</a>
    <div class="event-page-heading">
      <p class="eyebrow">Next transmission · Portland</p>
      <h1>{event.title}</h1>
    </div>
    <figure class="event-page-flyer">
      <Image src={eventFlyer} alt="Root & Resonance event flyer with schedule and venue details" />
    </figure>
    <div class="event-page-details">
      <div><span>When</span><p>{event.displayDate}, 2026<br />{event.time}<br /><small>{event.doors}</small></p></div>
      <div><span>Where</span><p>{event.location}<br /><small>{event.address}</small></p></div>
      <div><span>Admission</span><p>{event.age}<br />{event.ticketPrice}<br /><small>No refunds · Free parking</small></p></div>
    </div>
    <div class="event-page-body">
      <div>
        <p class="eyebrow">Move · meet · dance · heal</p>
        <p class="event-note">{event.description}</p>
        <a class="ticket-link" href={event.ticketHref} target="_blank" rel="noreferrer">Get tickets on Eventbrite <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="event-schedule" aria-label="Event schedule">
        {event.schedule.map((item) => (
          <li>
            <time>{item.time}</time>
            <div><strong>{item.title}</strong>{item.artist && <span>{item.artist}</span>}</div>
          </li>
        ))}
      </ol>
    </div>
  </article>
</BaseLayout>
