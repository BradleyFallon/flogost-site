---
import { Image } from "astro:assets";
import eventFlyer from "../assets/root-and-resonance-flyer.png";
import { event } from "../data/site";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const eventUrl = `${base}${event.href}`;
---

<section class="event-feature shell" id="next" aria-labelledby="next-title">
  <div class="section-marker">
    <span>01</span>
    <p>Next transmission</p>
  </div>
  <div class="event-content">
    <p class="eyebrow">Live in Portland</p>
    <h2 id="next-title">{event.title}</h2>
    <div class="event-meta">
      <p>{event.displayDate} · {event.time}</p>
      <p>{event.location}</p>
      <p>{event.city} · {event.age}</p>
    </div>
    <div class="event-links">
      <a class="text-link" href={event.ticketHref} target="_blank" rel="noreferrer">Get tickets <span aria-hidden="true">↗</span></a>
      <a class="text-link text-link-muted" href={eventUrl}>Event details <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <figure class="event-art">
    <Image src={eventFlyer} alt="Root & Resonance event flyer with a dancer above branching roots" loading="lazy" />
  </figure>
</section>
