---
import { Image } from "astro:assets";
import cosmicHaunting from "../assets/cosmic-haunting.webp";
import { event } from "../data/site";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const eventUrl = `${base}${event.href}`;
---

<section class="event-feature shell" id="next" aria-labelledby="next-title">
  <div class="section-marker">
    <span>01</span>
    <p>Next transmission</p>
  </div>
  <div class="event-content">
    <p class="eyebrow">Live in Portland</p>
    <h2 id="next-title">{event.title}</h2>
    <div class="event-meta">
      <p>{event.displayDate}</p>
      <p>{event.location}</p>
      <p>{event.city}</p>
    </div>
    <a class="text-link" href={eventUrl}>Enter event details <span aria-hidden="true">↗</span></a>
  </div>
  <figure class="event-art">
    <Image src={cosmicHaunting} alt="Spectral figures gathering beneath a violet cosmic sky" loading="lazy" />
  </figure>
</section>
