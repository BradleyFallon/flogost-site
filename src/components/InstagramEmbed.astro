---
import { instagramProfile } from "../data/site";
---

<section class="instagram-feature shell" id="instagram" aria-labelledby="instagram-title">
  <div class="section-marker"><span>04</span><p>Instagram</p></div>
  <div class="instagram-copy">
    <p class="eyebrow">Dispatches from the surface</p>
    <h2 id="instagram-title">Follow the signal.</h2>
    <p>New work, live fragments, and transmissions from the FLOGOST orbit.</p>
    <a class="text-link" href={instagramProfile.href} target="_blank" rel="noreferrer">Open Instagram <span aria-hidden="true">↗</span></a>
  </div>
  <div class="instagram-profile">
    <blockquote
      class="instagram-media"
      data-instgrm-permalink={`${instagramProfile.href}?utm_source=ig_embed&utm_campaign=loading`}
      data-instgrm-version="14"
    >
      <a href={instagramProfile.href} target="_blank" rel="noreferrer">View @flogost_music on Instagram</a>
    </blockquote>
  </div>
</section>

<script is:inline async src="https://www.instagram.com/embed.js"></script>
